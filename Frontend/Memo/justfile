www := "/var/www/organizator.ro"

# default target
default: deploy-deb

build:
  reset
  npm run build
  # not sure if this does anything useful, maybe remove it?
  cp favicon-green.ico build/main/favicon.ico

install-dependencies:
  npm update
  npm install
  npm install typescript --save-dev

# no longer used
__deploy: build
  cp src/html/* {{www}}
  cp -r build/main/dom/ {{www}}

vite: build
  cp -r ../organizator-wasm/pkg/ build/main/
  npm run vite:build

dev: vite
  npm run dev

deb: vite
  rm -rf deb
  cp -rL deb-links/. deb

# deploy the compiled modules (one js with everything)
deploy-deb: deb
  cp -r deb/. {{www}}
  cp favicon-green.ico {{www}}/favicon.ico  

