{
  "name": "organizator_memo",
  "version": "1.0.0",
  "description": "Web interface for memos in Organizator",
  "main": "index.js",
  "scripts": {
    "build:dom": "tsc --build src",
    "copy:js": "rsync -r src/main/dom/*.js build/main/dom",
    "copy:html": "rsync -r src/html/ build/main",
    "copy:images": "rsync -r images build/main/",
    "build": "run-s build:dom copy:js copy:html copy:images",
    "_test": "echo \"Error: no test specified\" && exit 1",
    "prettier": "prettier --require-pragma --write src",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "dev": "vite",
    "vite:build": "vite build",
    "buildv": "run-s build vite:build",
    "playwrite-firefox": "npx playwright install --with-deps firefox",
    "test:browser": "vitest --config=vitest.browser.config.ts"
  },
  "author": "Ovidiu Ionescu",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@types/node": "^25.9.3",
    "@vitest/browser": "^4.1.2",
    "@vitest/browser-playwright": "^4.1.2",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.58.2",
    "prettier": "^2.0.1",
    "typescript": "^6.0.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.2"
  }
}
