# The wasm renderer used to be staged into public/ here, for the calendar screen. Notes are drawn
# by the memo app now, which builds the same module into its own bundle — so this app ships no copy
# of it and there is one wasm on the host rather than two.

# default
run:
  ng serve --host=0.0.0.0 --serve-path=/angular-dev-server/ --configuration development

deploy: build
  mkdir -p /var/www/organizator.ro/user-admin
  cp -r dist/user-administration/browser/* /var/www/organizator.ro/user-admin/

build:
  ng build --base-href=/user-admin/
